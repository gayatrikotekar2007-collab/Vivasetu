# VivaSetu Backend — Environment Variables
# Copy this file to .env and fill in real values.
# All placeholder values below are OBVIOUSLY FAKE — never use them in production.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev:   sqlite:///./vivasetu.db
DATABASE_URL=postgresql://postgres:your-postgres-password-here@localhost:5432/vivasetu

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong unique secret for production
JWT_SECRET_KEY=your-jwt-secret-key-here-replace-with-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Provider ───────────────────────────────────────────────────────────────
# Leave empty to run in DEMO/MOCK mode (no real AI, clearly labeled in UI)
# Obtain and set a real API key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
AI_REQUEST_TIMEOUT_SECONDS=30

# ── Admin ─────────────────────────────────────────────────────────────────────
# Used as X-Admin-Secret header for admin endpoints
# Set a secure admin secret before deploying
ADMIN_SECRET=your-admin-secret-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173/

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_OCR_FALLBACK=false

# ── Mastery ───────────────────────────────────────────────────────────────────
MASTERY_WEIGHT_NEW=0.3

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
