# VivaSetu — Root .env.example for docker-compose
# Copy this file to .env and fill in real values.
# All placeholder values are OBVIOUSLY FAKE.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=vivasetu
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=vivasetu

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vivasetu:your-postgres-password-here@db:5432/vivasetu
JWT_SECRET_KEY=your-jwt-secret-key-here-replace-with-long-random-string
ADMIN_SECRET=your-admin-secret-here
CORS_ORIGINS=http://localhost
GROQ_API_KEY=your-groq-api-key-here
AI_REQUEST_TIMEOUT_SECONDS=30
ENABLE_OCR_FALLBACK=false
MASTERY_WEIGHT_NEW=0.3
RATE_LIMIT_PER_MINUTE=30

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
